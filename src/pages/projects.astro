---
import Layout from "@/layouts/Layout.astro";
import { profile } from "@/settings";
import BetterIcon from "@/components/ui/BetterIcon.astro";
import List from "@/components/ui/List.astro";
import {RESEARCH_ICONS} from "@/data/researchIcons";

const { research_areas } = profile;
---

<Layout title="Projects">
  <div class="prose max-w-none">
    <h1 class="text-3xl font-bold mb-8">Projects</h1>

    <div class="mb-12">
      <p class="text-lg mb-6">
        A selection of projects I have worked on over the past years, including projects from academic courses and bachelor and master theses.
      </p>
    </div>

    <List listTitle="Projects Archive" listItems={[
      {
        title: "Machine Learning for Process Optimization in Pharmaceutical Manufacturing",
        description: "Can extended sterilization processes be predicted by combining sensors’ data and machine learning? This project studies diverse architectures and their anomaly detection performance. Development, comparison and analysis of LSTM-based classification and forecasting architectures under imbalanced datasets and real world constraints.",
        keywords: ["Python","PyTorch", "LSTM", "Anomaly Detection", "Predictive Maintenance"]
      },
      {
        title: "Design and Implementation of an Automatic Hand Kinematics Analysis System in Stroke Patients",
        description: "System for measuring kinematic variables of hand movement, applying deep learning techniques using the DeepLabCut Python package, to estimate hand's position in videos.",
        keywords: ["Python","Computer Vision", "DeepLabCut", "eHealth"]
      }
    ]} />

  </div>
</Layout>
