---
import Layout from "@/layouts/Layout.astro";
import { profile } from "@/settings";
import BetterIcon from "@/components/ui/BetterIcon.astro";
import List from "@/components/ui/List.astro";
import {RESEARCH_ICONS} from "@/data/researchIcons";

const { research_areas } = profile;
---

<Layout title="After Hours">
  <div class="prose max-w-none">
    <h1 class="text-3xl font-bold mb-8">After Hours</h1>

    <div class="mb-4">
      <p class="text-lg mb-2">
        Here you can find a glimpse of my life outside of work and Danish lessons!
      </p>
    </div>

    <h2 class="text-2xl font-bold mb-4">Interests & Hobbies</h2>
    <div class="grid gap-4 mb-4">
      <p class="text-lg mb-4">I enjoy deep conversations, long walks (you can ask me about <i>Camino de Santiago</i>), pilates workouts, sewing projects and salsa dancing. 
      Below you can find one of my favourite cuban son records. </p>
    </div>
    <div class="flex justify-center">
      <iframe 
        data-testid="embed-iframe" 
        style="border-radius:12px" 
        src="https://open.spotify.com/embed/track/5sbw5zIz9ck2pOEDXUR0QU?utm_source=generator" 
        width="60%" 
        height="152" 
        frameBorder="0" 
        allowfullscreen="" 
        allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture" 
        loading="lazy">
      </iframe>
    </div>

    <List listTitle="Volunteering & Personal Development" listItems={[
      {
        title: "Buddy for Master Students @ DTU Introduction Week",
        description: "Mentoring a group of new students during their first semester, providing academic and personal guidance. This includes helping them adjust to university life by listening to their concerns, organizing group activities, offering advice on navigating campus resources and helping them feel welcomed and supported."
      },
      {
        title: "Volunteer @ Power to Code",
        description: "Program dedicated to female students from different backgrounds to explore leadership topics such as DEI, presentation techniques and negotiation skills in 6 dedicated workshops.",
      },
      {
        title: "Participant @ Student Female Leadership Academy",
        description: "Promotion of the programme Technovation Girls, team competition to encourage girls to use technology to solve problems in their community. Translation of the competition’s curriculum from English to Spanish."
      }
    ]} />

  </div>
</Layout>
