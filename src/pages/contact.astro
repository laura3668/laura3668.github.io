---
import Layout from "@/layouts/Layout.astro";
import { profile, social } from "@/settings";
import BetterIcon from "@/components/ui/BetterIcon.astro";
import List from "@/components/ui/List.astro";
import SocialIcons from "@/components/ui/SocialIcons.astro";
import {RESEARCH_ICONS} from "@/data/researchIcons";

const { research_areas } = profile;
---

<Layout title="Contact">
  <div class="prose max-w-none text-center">
    <h1 class="text-3xl font-bold mb-8">Say hello!</h1>

    <div class="mb-6">
      <p class="text-lg mb-6">
        I'm always happy to connect! Do you want to discuss some of my projects, interests or chat about working together? You can reach out via the following social media:
      </p>
    </div>

    <div class='flex justify-center items-center gap-4 mt-2'>
			<SocialIcons/>
		</div>

  </div>
</Layout>
